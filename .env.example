# Copy to .env and adjust.  .env is gitignored; .env.example is committed.

# --- Embeddings -------------------------------------------------------------
# stub = deterministic fake vectors, no infra needed (CI, and first smoke run).
#        Retrieval quality is meaningless by construction — see notebook 03 §7.
# tei  = an HTTP embedding service implementing TEI's contract. Either real TEI,
#        or scripts/embed_server.py on a box without nvidia-container-toolkit.
# st   = sentence-transformers in-process (needs the [local] extra; GPU box only).
RAG_EMBED_PROVIDER=stub
RAG_TEI_URL=http://localhost:8080
RAG_EMBED_MODEL=BAAI/bge-m3
RAG_EMBED_BATCH_SIZE=64

# Set only when ingest and query are separate deployments, so a reindex
# saturating the GPU cannot blow the query latency SLO. See rag/embed/provider.py.
# RAG_TEI_INGEST_URL=http://gpu-box:8002

# NOTE: there is deliberately no RAG_EMBED_DIM / RAG_QUERY_PREFIX / RAG_DOC_PREFIX.
# Dimension and prefix convention are properties of the *model*, not the
# environment, and live in rag/embed/registry.py — the versioned model contract.
# Making them env vars is how the asymmetric-prefix bug gets into production:
# nothing validates them, and the failure is silent. See registry.py's docstring.

# --- Storage ----------------------------------------------------------------
RAG_QDRANT_URL=http://localhost:6333
RAG_COLLECTION=rag_chunks
RAG_POSTGRES_DSN=postgresql://rag:rag@localhost:5432/rag

# --- Generation (Phase 1 onwards) -------------------------------------------
# Not RAG_-prefixed: the Anthropic SDK reads this name directly.
# ANTHROPIC_API_KEY=sk-ant-...
