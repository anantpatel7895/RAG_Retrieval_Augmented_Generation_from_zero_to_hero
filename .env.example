# Copy to .env and adjust.  .env is gitignored; .env.example is committed.

# --- Generation -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Embeddings -------------------------------------------------------------
# stub = deterministic fake vectors, no infra needed (CI + first smoke run)
# tei  = the GPU box
# st   = sentence-transformers in-process (only on the GPU box, needs [local] extra)
RAG_EMBED_PROVIDER=stub
RAG_TEI_URL=http://localhost:8080
RAG_EMBED_MODEL=BAAI/bge-m3
RAG_EMBED_DIM=1024

# bge-m3 needs NO prefixes. e5-family needs "query: " / "passage: ".
# Getting this wrong silently costs 5-15 pts of recall -- see PLAN.md Phase 4.
RAG_QUERY_PREFIX=
RAG_DOC_PREFIX=

# --- Storage ----------------------------------------------------------------
RAG_QDRANT_URL=http://localhost:6333
RAG_COLLECTION=rag_chunks
RAG_POSTGRES_DSN=postgresql://rag:rag@localhost:5432/rag

# --- Observability ----------------------------------------------------------
RAG_RUNS_DIR=runs
